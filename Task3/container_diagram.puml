@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(customer, "Клиент")

System(public_site, "Публичный сайт", "Просмотр продуктов, подача заявки")
System(callcenter, "Система колл-центра", "Обработка заявок с сайта")
System(mq, "Message Queue / Event Bus", "Буферизация заявок")
System(sms_service, "SMS-сервис", "Отправка и проверка кодов")

System_Boundary(ib_sys, "Интернет-банк") {
    Container(ib_ui, "IB Web UI", "Форма заявки и ввод SMS-кода")
    Container(ib_backend, "IB Backend", "Бизнес-логика заявки, управление SMS и скорингом, публикация в очередь")
}

System_Boundary(abs_sys, "АБС") {
    Container(abs_api, "ABS API", "Обработка заявок и создание депозитов")
    Container(abs_core, "ABS Core", "Учёт депозитов и операций")
}

Rel(customer, public_site, "Подаёт заявку")
Rel(public_site, callcenter, "Передача заявки в обработку")
Rel(callcenter, mq, "Публикация заявки в очередь")

Rel(customer, ib_ui, "Подаёт заявку / вводит SMS-код")
Rel(ib_ui, ib_backend, "REST API")
Rel(ib_backend, sms_service, "Отправка SMS-кода / проверка")

Rel(ib_backend, mq, "Публикация подтверждённой заявки")
Rel(mq, abs_api, "Получение заявки для обработки")
Rel(abs_api, abs_core, "Создание депозита и запись операций")

@enduml
